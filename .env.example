# Copier ce fichier en .env (jamais commité) puis remplir les valeurs.
#   PowerShell : Copy-Item .env.example .env

# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Gemini (bloc 2 : analyse photo ; bloc 4 : chatbot RAG)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Chatbot (bloc 4) : embeddings Gemini + base vectorielle Qdrant
GEMINI_EMBED_MODEL=gemini-embedding-001
# Vide = Qdrant embarque (dossier qdrant_data/, aucun serveur). Sinon : http://localhost:6333 ou Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
# Chatbot vocal en tounsi : Azure Speech (portail Azure > « Speech service », offre gratuite F0)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# ar-TN-ReemNeural (femme) ou ar-TN-HediNeural (homme)
AZURE_TTS_VOICE=ar-TN-HediNeural
AZURE_STT_LANGUAGE=ar-TN
# Sans Azure (gratuit, sans carte) : voix tunisiennes edge-tts + ecoute Whisper Derja locale
VOIX_EDGE_TTS=True
# identifiant Hugging Face (telecharge une fois, ~250 Mo) ou dossier local du modele ; vide = desactive
WHISPER_DERJA_MODEL=TheBiggyBang/whisper-small-tunisian-derja-ct2
# Vrai accent tunisien (Lahgtna, gratuit) ; la voix edge-tts ci-dessus reste le secours
VOIX_LAHGTNA=True
# Jeton Hugging Face gratuit (compte sans carte) : https://huggingface.co/settings/tokens -> type « Read »
HF_TOKEN=
# Autre voix a imiter (+ son texte exact, en lettres arabes) ; vide = services/rag/voix_tounsi.wav
# VOIX_REFERENCE=D:\chemin\ma_voix.wav
# VOIX_REFERENCE_TEXTE=...
# Texte du chatbot : arabe (derja en lettres arabes), arabizi (lettres latines) ou meme (meme ecriture que l'agriculteur)
CHAT_ECRITURE=arabe

# Bloc 3 : reseau goutte-a-goutte
# Google Maps (activer "Map Tiles API" + "Maps JavaScript API" sur la cle).
# Avec une cle, l'image analysee vient de Google (zoom 20-21) ; sans cle, d'Esri (zoom 18-19).
GOOGLE_MAPS_API_KEY=
# Cle navigateur separee (restreinte par referent HTTP), facultative :
# GOOGLE_MAPS_BROWSER_KEY=
# Forcer un fournisseur : google | esri | mapbox (MAPBOX_TOKEN)
# SATELLITE_FOURNISSEUR=
# SATELLITE_ZOOM=20
# Detection des plantes par Gemini Vision (utilise GEMINI_API_KEY ci-dessus) : True / False
DETECTION_IA=True
