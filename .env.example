# Copier ce fichier en .env (jamais commité) puis remplir les valeurs.
#   PowerShell : Copy-Item .env.example .env

# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Gemini (bloc 2 : analyse photo ; bloc 4 : chatbot RAG)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Bloc 3 : reseau goutte-a-goutte
# Google Maps (activer "Map Tiles API" + "Maps JavaScript API" sur la cle).
# Avec une cle, l'image analysee vient de Google (zoom 20-21) ; sans cle, d'Esri (zoom 18-19).
GOOGLE_MAPS_API_KEY=
# Cle navigateur separee (restreinte par referent HTTP), facultative :
# GOOGLE_MAPS_BROWSER_KEY=
# Forcer un fournisseur : google | esri | mapbox (MAPBOX_TOKEN)
# SATELLITE_FOURNISSEUR=
# SATELLITE_ZOOM=20
# Detection des plantes par Gemini Vision (utilise GEMINI_API_KEY ci-dessus) : True / False
DETECTION_IA=True
