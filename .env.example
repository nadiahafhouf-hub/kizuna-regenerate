# Copier ce fichier en .env (jamais commité) puis remplir les valeurs.
#   PowerShell : Copy-Item .env.example .env

# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Gemini (bloc 2 : analyse photo ; bloc 4 : chatbot RAG)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Bloc 3 : image satellite du reseau goutte-a-goutte (esri par defaut, sans cle)
SATELLITE_FOURNISSEUR=esri
SATELLITE_ZOOM=19
